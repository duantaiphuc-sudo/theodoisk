rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Authorized Admins: duantaiphuc@gmail.com and admin@theodoisk.com (admin)
    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email != null && (
          request.auth.token.email.lower() == 'duantaiphuc@gmail.com' ||
          request.auth.token.email.lower() == 'admin@theodoisk.com'
        )) ||
        request.auth.uid == 'usr-phuc-google' ||
        request.auth.uid == 'usr-admin-01'
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles and all user subcollections (e.g. history)
    match /users/{userId} {
      allow read, write: if true;
      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    // Isolated telemetry per user account and subcollections
    match /user_telemetry/{document=**} {
      allow read, write: if true;
    }

    // Telemetry current state (IoT node compatibility)
    match /theodoisk/{document=**} {
      allow read, write: if true;
    }

    // Telemetry history (general)
    match /theodoisk_history/{document=**} {
      allow read, write: if true;
    }

    // Devices telemetry history
    match /devices_history/{document=**} {
      allow read, write: if true;
    }

    // Custom telemetry collections configured by users and all subcollections
    match /{collectionName}/{document=**} {
      allow read, write: if true;
    }

    // Notifications and assigned tasks
    match /notifications/{document=**} {
      allow read, write: if true;
    }
  }
}
