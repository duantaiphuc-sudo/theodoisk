rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Core Authentication & RBAC Primitives
    function isAuthenticated() {
      return request.auth != null;
    }

    // Role Admin strictly based on Firebase Auth Custom Claim (admin: true) or designated admin email
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'duantaiphuc@gmail.com' ||
        request.auth.token.email == 'nguyentai51.2k4@gmail.com'
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper: Check if user's paired deviceId matches target device
    function isPairedDevice(deviceId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.deviceId == deviceId ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.device == deviceId
        );
    }

    // Telemetry validation helper: Enforce data types and biometric ranges
    function isValidTelemetry(data, expectedUserId) {
      return data.userId == expectedUserId &&
        data.bpm is number && data.bpm >= 0 && data.bpm <= 250 &&
        data.spo2 is number && data.spo2 >= 0 && data.spo2 <= 100 &&
        data.posture_status is int && data.posture_status >= -1 && data.posture_status <= 5;
    }

    // 2. User Profiles & Settings
    match /users/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      // User can create their own initial profile as employee; cannot set role: admin or deviceId without admin
      allow create: if isAdmin() || (
        isOwner(userId) &&
        (!('role' in request.resource.data) || request.resource.data.role == 'employee') &&
        (!('deviceId' in request.resource.data))
      );
      // User can update profile info, but cannot self-assign admin role or alter deviceId
      allow update: if isAdmin() || (
        isOwner(userId) &&
        (!('role' in request.resource.data) || !('role' in resource.data) || request.resource.data.role == resource.data.role) &&
        (!('deviceId' in request.resource.data) || !('deviceId' in resource.data) || request.resource.data.deviceId == resource.data.deviceId || request.resource.data.deviceId == '' || request.resource.data.deviceId == null) &&
        (!('device' in request.resource.data) || !('device' in resource.data) || request.resource.data.device == resource.data.device || request.resource.data.device == '' || request.resource.data.device == null)
      );
      allow delete: if isAdmin();

      // Historical telemetry partitioned per user account
      match /history/{docId} {
        allow read: if isAdmin() || isOwner(userId);
        allow create: if isOwner(userId) && isValidTelemetry(request.resource.data, userId);
        allow update: if false;
        allow delete: if isAdmin() || isOwner(userId);
      }

      match /{subcollection=**} {
        allow read: if isAdmin() || isOwner(userId);
        allow create, update: if isAdmin() || isOwner(userId);
        allow delete: if isAdmin();
      }
    }

    // 3. User Telemetry Presence / Live State
    match /user_telemetry/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      match /{subcollection=**} {
        allow read: if isAdmin() || isOwner(userId);
        allow create, update: if isOwner(userId) || isAdmin();
        allow delete: if isAdmin();
      }
    }

    // 4. Hardware Devices & Live Streams (Raspberry Pi 4)
    // Pi 4 uses firebase-admin SDK (bypasses rules).
    // Allow authenticated users to read live telemetry streams (dashboard telemetry feed).
    // Allow Admin to write, test, calibrate, or reset devices.
    match /devices/{deviceId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();

      // Cho phép nhân viên gửi lệnh xác thực khuôn mặt SFace (face_commands)
      match /face_commands/{cmdId} {
        allow read: if isAuthenticated() && (
          isAdmin() ||
          resource.data.uid == request.auth.uid
        );
        allow create: if isAuthenticated() && 
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.device_id == deviceId &&
          request.resource.data.status == 'PENDING' &&
          request.resource.data.type in ['ENROLL_FACE', 'VERIFY_FACE', 'LOGOUT_FACE'];
        allow update, delete: if isAdmin();
      }

      // Thông tin gán thiết bị độc quyền (Admin gán, người dùng đọc)
      match /assignment/{docId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
      }

      // Trạng thái phiên làm việc (Session Ver 5)
      match /session/{docId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
      }

      match /{subcollection=**} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
      }
    }

    match /theodoisk/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();

      match /{subcollection=**} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
      }
    }

    match /devices_history/{logId} {
      allow read: if isAdmin() || (
        isAuthenticated() && (
          resource.data.userId == request.auth.uid ||
          resource.data.user_id == request.auth.uid ||
          (resource.data.device != null && isPairedDevice(resource.data.device))
        )
      );
      allow write: if false;
    }

    // 5. Partitioned and Top-level Telemetry History
    match /theodoisk_history/users/{userId}/history/{docId} {
      allow read: if isAdmin() || isOwner(userId);
      allow create: if isOwner(userId) && isValidTelemetry(request.resource.data, userId);
      allow update: if false;
      allow delete: if isAdmin() || isOwner(userId);
    }

    match /theodoisk_history/{docId} {
      allow read: if isAdmin() || (
        isAuthenticated() && (
          resource.data.userId == request.auth.uid ||
          resource.data.user_id == request.auth.uid
        )
      );
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        isValidTelemetry(request.resource.data, request.auth.uid);
      allow update: if false;
      allow delete: if isAdmin();
    }

    // 6. Notifications & Admin Task Dispatching
    match /notifications/{notifId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.targetUserId == request.auth.uid);
      allow create: if isAdmin();
      allow update: if isAdmin() || (isAuthenticated() && resource.data.targetUserId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // 7. Biometric Face Templates (YuNet + SFace 128D Embedding)
    match /face_templates/{userId} {
      // Chỉ tài khoản sở hữu hoặc Quản trị viên mới được đọc vector khuôn mặt
      allow get: if isAdmin() || isOwner(userId);
      // Chặn người dùng thường list/quét toàn bộ database khuôn mặt của người khác
      allow list: if isAdmin();
      // Quản trị viên hoặc chính chủ có quyền cập nhật, đặt lại hoặc xóa mẫu của mình
      allow create, update, delete: if isAdmin() || isOwner(userId);
    }

    // 8. Global Safety Net - Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
